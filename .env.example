# SPDX-License-Identifier: LicenseRef-Tess-Community-Enterprise
# Community edition: personal use. Enterprise edition: commercial use. See LICENSE.md.

# Copy to `.env` (never commit it) and fill in the secrets.
# Generate random values with:  openssl rand -hex 32

# --- License: community | commercial -------------------------------------------------
# Community: personal use. Any commercial use needs the commercial license and its
# key (tess_…); it excludes the embedded n8n workflow editor. See LICENSE.md.
TESS_LICENSE=community
# TESS_LICENSE_KEY=

# --- Required secrets --------------------------------------------------------
# Bootstrap admin token (>= 32 chars), sent as `Authorization: Bearer <token>`.
# It acts as the "system" Owner: use it to create the first Owner account
# (admin UI first-run screen), then REMOVE it and restart.
TESS_ADMIN_TOKEN=
# Key signing user sessions (>= 32 bytes). Changing it signs everybody out.
TESS_SESSION_SECRET=
# TESS_SESSION_TTL=12h
# Keys for opaque API ids and stable refs (>= 32 bytes each, different).
TESS_ID_SECRET=
TESS_REF_SECRET=
# Optional: previous id secrets (comma-separated) during a key rotation.
# TESS_ID_SECRET_PREVIOUS=
TESS_ID_TTL=24h
# Key encrypting integration secrets stored in the database (webhook signing
# secrets, storage keys of translation delivery targets), >= 32 bytes.
# Without it, TESS_SESSION_SECRET is used. Changing it makes them unreadable.
TESS_SECRETS_KEY=

# --- Database: rocksdb | sqlite | postgres | mysql | mongodb | dynamodb | memory --
TESS_DATABASE=rocksdb
# sqlite (embedded, no service; in Docker keep it on the /data volume)
# DATABASE_URL=sqlite:///data/tess.db
# postgres (compose profile `postgres`)
# DATABASE_URL=postgres://tess:CHANGE_ME@postgres:5432/tess
# POSTGRES_PASSWORD=CHANGE_ME
# mysql 8+ (compose profile `mysql`); MySQL 8 auth requires TLS
# DATABASE_URL=mysql://tess:CHANGE_ME@mysql:3306/tess?ssl-mode=required
# MYSQL_PASSWORD=CHANGE_ME
# mongodb (compose profile `mongodb`)
# MONGODB_URL=mongodb://mongo:27017
# dynamodb (compose profile `dynamodb`, DynamoDB Local)
# DYNAMODB_TABLE=tess
# DYNAMODB_ENDPOINT=http://dynamodb:8000
# DYNAMODB_CREATE_TABLE=true
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=local
# AWS_SECRET_ACCESS_KEY=local

# --- Media: fs | s3 -----------------------------------------------------------
TESS_MEDIA_STORE=fs
# S3-compatible store, e.g. Garage (compose profiles `s3` and `local`: the
# `garage-init` service creates this bucket and key at start)
# TESS_S3_BUCKET=tess-media
# TESS_S3_ENDPOINT=http://garage:3900
# TESS_S3_PUBLIC_ENDPOINT=http://localhost:3900   # as browsers reach it, for file URLs
# TESS_S3_REGION=garage
# TESS_S3_ACCESS_KEY_ID=GK...            # Garage: GK + 24 hex chars
# TESS_S3_SECRET_ACCESS_KEY=
# Public URL of the bucket/CDN, if files are publicly readable there:
# TESS_MEDIA_PUBLIC_URL=https://cdn.example.com
# Garage secrets (only for the `s3` compose profile):
# GARAGE_RPC_SECRET=
# GARAGE_ADMIN_TOKEN=

# --- Search: none | memory | typesense ------------------------------------------
TESS_SEARCH=none
# TYPESENSE_URL=http://typesense:8108
# TYPESENSE_API_KEY=

# --- Cache: none | memory | valkey | redis | keydb | dragonfly ---------------------
# Caches anonymous GraphQL read queries and served translation files; every
# change invalidates it. A server (any speaking the Redis protocol) is shared by
# all instances and also tells them when the content model changes. Compose
# profiles: cache (Valkey), cache-redis, cache-keydb, cache-dragonfly.
TESS_CACHE=none
# TESS_CACHE_URL=redis://valkey:6379           # rediss:// for TLS; redis://user:password@host:6379/0
# CACHE_MAXMEMORY=256mb                         # memory of the compose cache server
# TESS_CACHE_TTL_SECS=60
# TESS_CACHE_PREFIX=tess:

# --- Plugins ---------------------------------------------------------------------
TESS_PLUGINS=true
# TESS_PLUGIN_ALLOW_HTTP=true
# TESS_PLUGIN_MAX_TIMEOUT_MS=10000

# --- Translations (i18n) ----------------------------------------------------------
# TESS_I18N=true               # keys, languages, import/export, /i18n/{format}/{file}

# --- Forms -----------------------------------------------------------------------
# Custom forms: visitors POST to /api/forms/<slug> (rate limit per visitor and form, per minute).
# TESS_FORMS=true
# TESS_FORMS_RATE_LIMIT=10

# --- Webhooks ----------------------------------------------------------------------
# TESS_WEBHOOKS=true
# TESS_WEBHOOK_ALLOWED_HOSTS=n8n,*.example.com   # restrict targets (empty = any host)
# TESS_WEBHOOK_TIMEOUT_SECS=10
# TESS_WEBHOOK_MAX_ATTEMPTS=5

# --- Workflows (n8n, compose profile `n8n`) ----------------------------------------
# Tess proxies TESS_N8N_PATH (default /n8n/) to TESS_N8N_URL and shows the
# editor in the admin UI. Not available on AWS Lambda.
# TESS_N8N_URL=http://n8n:5678
# N8N_ENCRYPTION_KEY=                            # openssl rand -hex 32
# N8N_PUBLIC_URL=https://cms.example.com/n8n/    # as browsers reach it
# N8N_SECURE_COOKIE=true                         # behind HTTPS

# --- HTTP ------------------------------------------------------------------------
# TESS_PUBLIC_READ=true        # anonymous read access to PUBLISHED content
# TESS_CORS_ORIGINS=https://www.example.com
# TESS_GRAPHIQL=true
# MCP endpoint for AI agents at /mcp (off by default; see the MCP docs)
# TESS_MCP=true
# TESS_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,::1   # Host headers accepted on /mcp
# Used by `tess mcp` (stdio proxy for desktop agents), not by the server:
# TESS_MCP_URL=https://cms.example.com
# TESS_MCP_TOKEN=                                  # an API token, role decides access
# RUST_LOG=info
